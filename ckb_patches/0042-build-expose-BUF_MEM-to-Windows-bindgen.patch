 rust/build.sh                            |  8 +++++++-
 rust/patches/boringssl-bindgen-buf.patch | 10 ++++++++++
 3 files changed, 20 insertions(+), 1 deletion(-)
 create mode 100644 rust/patches/boringssl-bindgen-buf.patch

diff --git a/docs/APatch_定制适配说明_2026-08-21.md b/docs/APatch_定制适配说明_2026-08-21.md
index 8aa94a5..f0f0a71 100644
--- a/docs/APatch_定制适配说明_2026-08-21.md
+++ b/docs/APatch_定制适配说明_2026-08-21.md
@@ -65,6 +65,8 @@ Windows 的 `PATH` 可能优先命中 `C:\Windows\System32\bash.exe`（WSL 启
 
 Rust `openssl-sys` 会通过 bindgen 动态加载 `libclang.dll`，而 Android NDK 只提供目标编译器，不附带可供 bindgen 加载的 Windows libclang。统一编译脚本会把固定的 libclang 18.1.1 安装到 `.ckb-build-tools/libclang-18.1.1`，仅为本次构建注入 `LIBCLANG_PATH`，不修改系统环境变量。CMake 会把该变量显式写入 `rust_ta` 自定义命令，不依赖 Gradle、CMake 与 Ninja 多层进程的隐式环境继承。
 
+`openssl-sys` 0.9.117 的 BoringSSL bindgen allowlist 在 Windows 上无法匹配由 `buffer.h` 通过相对路径引入的 `buf.h`，会生成 `BUF_MEM = buf_mem_st` 却遗漏 `buf_mem_st` 定义。`rust/build.sh` 会幂等应用一个仅增加 `<openssl/buf.h>` 直接引入的 BoringSSL 补丁；它不改变 ABI 或实现，只让 bindgen 看见已经存在的结构体声明。
+
 本次代码修改没有执行编译、刷入或设备测试；由使用者自行完成。
 
 ## 不要重复踩的坑
@@ -74,5 +76,6 @@ Rust `openssl-sys` 会通过 bindgen 动态加载 `libclang.dll`，而 Android N
 - 不要为 daemon 新建显眼的 permissive SELinux 域。
 - 不要为了修 TEESimulator 去改 Vendor、IReZygisk 或全局模块脚本。
 - 不要把 NDK 中存在 `clang.exe` 当成 bindgen 已具备 `libclang.dll`；二者用途不同。
+- 不要直接修改 Cargo registry 中的 `openssl-sys`；缓存会被覆盖且无法随仓库复现。
 - 不要重新启用 TrickyStore 与 TEESimulator 同时 Hook keystore；上游安装脚本主动禁用 TrickyStore 是有意的冲突保护。
 - 升级上游时必须重新核对 `module/daemon`，避免上游覆盖 APatch 专用分支。
diff --git a/rust/build.sh b/rust/build.sh
index d90c34d..627da1f 100755
--- a/rust/build.sh
+++ b/rust/build.sh
@@ -37,7 +37,7 @@ export ANDROID_NDK_HOME="$NDK_HOME" ANDROID_NDK_ROOT="$NDK_HOME" ANDROID_NDK="$N
 # attestation security level (kmr-ta-seclevel.patch). Each patch is applied to the
 # submodule working tree, idempotently — skipped when it already reverse-applies,
 # i.e. is already present.
-for PATCH in "$HERE"/patches/*.patch; do
+for PATCH in "$HERE"/patches/kmr-*.patch; do
   if git -C "$ROOT/third_party/keymint" apply -p1 --reverse --check "$PATCH" 2>/dev/null; then
     :
   else
@@ -49,6 +49,12 @@ BORINGSSL="${BORINGSSL:-$ROOT/third_party/boringssl}"
 if [ ! -f "$BORINGSSL/include/openssl/base.h" ]; then
   git clone --depth 1 https://boringssl.googlesource.com/boringssl "$BORINGSSL"
 fi
+BORINGSSL_PATCH="$HERE/patches/boringssl-bindgen-buf.patch"
+if git -C "$BORINGSSL" apply -p1 --reverse --check "$BORINGSSL_PATCH" 2>/dev/null; then
+  :
+else
+  git -C "$BORINGSSL" apply -p1 "$BORINGSSL_PATCH"
+fi
 
 if [ -z "${LIBCLANG_PATH:-}" ]; then
   for p in /usr/lib /usr/lib64 /usr/lib/llvm/lib /usr/lib/x86_64-linux-gnu; do
diff --git a/rust/patches/boringssl-bindgen-buf.patch b/rust/patches/boringssl-bindgen-buf.patch
new file mode 100644
index 0000000..61990f9
--- /dev/null
+++ b/rust/patches/boringssl-bindgen-buf.patch
