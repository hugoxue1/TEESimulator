From db50dede8d212fc01d00d149bda25193265a1a59 Mon Sep 17 00:00:00 2001
From: "Phase49.1-main-agent" <hugoxue@auto.ai>
Date: Fri, 21 Aug 2026 20:42:12 +0800
Subject: [PATCH 41/47] build: pass libclang path to Rust target

---
 CMakeLists.txt                         | 4 ++++
 docs/APatch_定制适配说明_2026-08-21.md | 2 +-
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 4f5e5c5..8ce0095 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -131,6 +131,9 @@ endif()
 if(NOT BASH_EXECUTABLE)
   message(FATAL_ERROR "bash not found; install Git for Windows or add bash to PATH")
 endif()
+if(CMAKE_HOST_WIN32 AND "$ENV{LIBCLANG_PATH}" STREQUAL "")
+  message(FATAL_ERROR "LIBCLANG_PATH is missing; run through ckb_workspace/build_projects.py")
+endif()
 # ALWAYS invoke build.sh and let cargo decide incrementally what to rebuild. An OUTPUT custom command
 # with no source DEPENDS only runs when the .a is missing, so once built it was never refreshed on a
 # Rust source change — that once linked a stale 14-argument teesim_km_init_ex against a 16-argument C++
@@ -141,6 +144,7 @@ add_custom_target(rust_ta
     COMMAND ${CMAKE_COMMAND} -E env
             ABI=${ANDROID_ABI} API=${ANDROID_API_LEVEL} NDK_HOME=${ANDROID_NDK}
             BORINGSSL=${BORINGSSL_DIR}
+            "LIBCLANG_PATH=$ENV{LIBCLANG_PATH}"
             ${BASH_EXECUTABLE} ${CMAKE_SOURCE_DIR}/rust/build.sh
     VERBATIM USES_TERMINAL)
 
diff --git a/docs/APatch_定制适配说明_2026-08-21.md b/docs/APatch_定制适配说明_2026-08-21.md
index 68ba28f..8aa94a5 100644
--- a/docs/APatch_定制适配说明_2026-08-21.md
+++ b/docs/APatch_定制适配说明_2026-08-21.md
@@ -63,7 +63,7 @@ Windows 的 `PATH` 可能优先命中 `C:\Windows\System32\bash.exe`（WSL 启
 
 工作区统一编译脚本会为 TEESimulator 选择 NDK 28.2，并把工作区内固定的 Cargo、Rustc 与 cargo-ndk 4.1.2 加入子进程环境；不依赖用户的系统 `PATH`。
 
-Rust `openssl-sys` 会通过 bindgen 动态加载 `libclang.dll`，而 Android NDK 只提供目标编译器，不附带可供 bindgen 加载的 Windows libclang。统一编译脚本会把固定的 libclang 18.1.1 安装到 `.ckb-build-tools/libclang-18.1.1`，仅为本次构建注入 `LIBCLANG_PATH`，不修改系统环境变量。
+Rust `openssl-sys` 会通过 bindgen 动态加载 `libclang.dll`，而 Android NDK 只提供目标编译器，不附带可供 bindgen 加载的 Windows libclang。统一编译脚本会把固定的 libclang 18.1.1 安装到 `.ckb-build-tools/libclang-18.1.1`，仅为本次构建注入 `LIBCLANG_PATH`，不修改系统环境变量。CMake 会把该变量显式写入 `rust_ta` 自定义命令，不依赖 Gradle、CMake 与 Ninja 多层进程的隐式环境继承。
 
 本次代码修改没有执行编译、刷入或设备测试；由使用者自行完成。
 
