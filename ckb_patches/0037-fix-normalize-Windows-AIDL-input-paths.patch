From 635a1eb1ba7a0a096aca7d5188f536b2b6541072 Mon Sep 17 00:00:00 2001
From: "Phase49.1-main-agent" <hugoxue@auto.ai>
Date: Fri, 21 Aug 2026 20:01:49 +0800
Subject: [PATCH 37/47] fix: normalize Windows AIDL input paths

---
 CMakeLists.txt                         | 12 +++++++++++-
 docs/APatch_定制适配说明_2026-08-21.md |  2 ++
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 139cd5d..698ce86 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -71,10 +71,20 @@ if(NOT EXISTS ${AIDL_GEN}/.done)
   file(MAKE_DIRECTORY ${AIDL_GEN}/src ${AIDL_GEN}/include)
   foreach(pkg keymint secureclock sharedsecret)
     file(GLOB _aidls ${SEC}/${pkg}/aidl/android/hardware/security/${pkg}/*.aidl)
+    set(_aidl_inputs ${_aidls})
+    # Windows aidl normalizes import roots to backslashes but not forward-slash input paths; make
+    # the inputs native too so it recognizes that each file is under its own import root.
+    if(CMAKE_HOST_WIN32)
+      set(_aidl_inputs)
+      foreach(_aidl IN LISTS _aidls)
+        file(TO_NATIVE_PATH "${_aidl}" _aidl_native)
+        list(APPEND _aidl_inputs "${_aidl_native}")
+      endforeach()
+    endif()
     execute_process(
       COMMAND ${AIDL_BIN} --lang=ndk --structured --stability=vintf --min_sdk_version=29
               -I ${KM_AIDL} -I ${SC_AIDL} -I ${SS_AIDL}
-              -o ${AIDL_GEN}/src -h ${AIDL_GEN}/include ${_aidls}
+              -o ${AIDL_GEN}/src -h ${AIDL_GEN}/include ${_aidl_inputs}
       RESULT_VARIABLE _rc)
     if(NOT _rc EQUAL 0)
       message(FATAL_ERROR "aidl generation failed for ${pkg}")
diff --git a/docs/APatch_定制适配说明_2026-08-21.md b/docs/APatch_定制适配说明_2026-08-21.md
index 81974e5..eb8fa92 100644
--- a/docs/APatch_定制适配说明_2026-08-21.md
+++ b/docs/APatch_定制适配说明_2026-08-21.md
@@ -57,6 +57,8 @@ KeyMint、Android interfaces 和 frameworks/native 子模块使用中科大 AOSP
 
 CMake 选择 AIDL 时优先使用 Android SDK 中最新的 Build Tools，并识别 Windows 的 `aidl.exe`。若旧构建缓存仍记录不支持 `--min_sdk_version` 的 AIDL，会自动丢弃该缓存后重新选择，避免 Build Tools 30.0.3 抢在已安装的 36.x 前面。
 
+Windows 版 AIDL 会把 `-I` 目录规范化为反斜杠，但不会同步规范化 CMake 传入的源文件路径，从而把同一目录误判为“不在 import paths”。配置阶段仅在 Windows 主机上把 AIDL 的输入、导入和输出路径统一转换为原生格式；Android/Linux 构建参数保持不变。
+
 本次代码修改没有执行编译、刷入或设备测试；由使用者自行完成。
 
 ## 不要重复踩的坑
