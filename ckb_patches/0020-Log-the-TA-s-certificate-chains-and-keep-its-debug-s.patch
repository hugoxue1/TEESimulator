From 75d2d558a797dabcc00de0798e9e2b5cc5fb3a8f Mon Sep 17 00:00:00 2001
From: JingMatrix <jingmatrix@gmail.com>
Date: Mon, 10 Aug 2026 22:51:06 +0200
Subject: [PATCH 20/47] Log the TA's certificate chains and keep its debug
 symbols

Instrument the reference TA so a capture shows exactly what it produced.
generate_key and import_key log their parameters and the resulting chain,
patch_attestation logs the input leaf and the patched output, and the keybox is
dumped (both the RSA and EC chains) when it is parsed. A shared
resign::log_chain / describe_cert renders each certificate as "subject <= issuer".

Keep line tables and symbols in the release archive (strip = false, debug = true)
so a panic in the TA symbolicates to a Rust file:line in the tombstone. The
shipped release .so is still stripped by AGP; the debug variant keeps the symbols
(app/build.gradle.kts keepDebugSymbols). Also drop the unused kmr-tests dependency.
---
 rust/Cargo.toml              |  7 ++++--
 rust/teesim-km/src/attest.rs |  8 +++++--
 rust/teesim-km/src/ops.rs    | 41 ++++++++++++++++++++++++++++++++++--
 rust/teesim-km/src/resign.rs | 28 ++++++++++++++++++++++++
 4 files changed, 78 insertions(+), 6 deletions(-)

diff --git a/rust/Cargo.toml b/rust/Cargo.toml
index 2fd9bbf..11d743e 100644
--- a/rust/Cargo.toml
+++ b/rust/Cargo.toml
@@ -12,11 +12,14 @@ kmr-common = { path = "../third_party/keymint/common" }
 kmr-derive = { path = "../third_party/keymint/derive" }
 kmr-wire = { path = "../third_party/keymint/wire" }
 kmr-ta = { path = "../third_party/keymint/ta" }
-kmr-tests = { path = "../third_party/keymint/tests" }
 kmr-crypto-boring = { path = "../third_party/keymint/boringssl" }
 
 [profile.release]
 panic = "unwind"
 opt-level = "z"
 lto = true
-strip = true
+# Keep debug info (line tables) and symbols so a crash in the TA symbolicates to a Rust file:line in
+# the tombstone. build.sh always builds --release; the shipped release .so is still stripped by AGP,
+# while the debug variant keeps these symbols (see app/build.gradle.kts keepDebugSymbols).
+strip = false
+debug = true
