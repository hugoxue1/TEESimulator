+pub struct TsDeviceIds {
+    pub brand: *const u8,
+    pub brand_len: usize,
+    pub device: *const u8,
+    pub device_len: usize,
+    pub product: *const u8,
+    pub product_len: usize,
+    pub serial: *const u8,
+    pub serial_len: usize,
+    pub imei: *const u8,
