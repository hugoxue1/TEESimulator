+                      uint32_t os_patchlevel, uint32_t vendor_patchlevel,
+                      uint32_t boot_patchlevel, const uint8_t *vb_key,
+                      size_t vb_key_len, const uint8_t *vb_hash, size_t vb_hash_len,
