diff --git a/keystore/aosp/include/binder/PersistableBundle.h b/keystore/aosp/include/binder/PersistableBundle.h
new file mode 100644
index 0000000..7c3b625
--- /dev/null
+++ b/keystore/aosp/include/binder/PersistableBundle.h
@@ -0,0 +1,130 @@
+/*
