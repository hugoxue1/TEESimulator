 .gitignore           |  1 +
 module/customize.sh  | 25 ++++++++++++++++++++++
 module/module.prop   |  6 ++++++
 module/sepolicy.rule |  7 ++++++
 module/service.sh    | 34 +++++++++++++++++++++++++++++
 module/target.txt    |  1 +
 package.sh           | 51 ++++++++++++++++++++++++++++++++++++++++++++
 7 files changed, 125 insertions(+)
